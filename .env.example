# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Your Telegram user ID (for admin access)
TELEGRAM_ADMIN_ID=

# Private key for trading wallet (without 0x prefix)
PRIVATE_KEY=

# Robinhood Chain RPC
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# true = only simulate trades, false = execute real transactions
DRY_RUN=true
